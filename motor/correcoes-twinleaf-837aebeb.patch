@@ -3999,3 +4002,44 @@ export function BREAK_RULE(effect: Effect, state: State, source: PokemonCard): S
 //       }
 //     }
 //   });
+
+/**
+ * PrizeSpy: dano de ataque que "não é afetado por nenhum efeito no Pokémon Ativo do oponente" (Shred, Destructive Drill).
+ * Pela regra, só os efeitos do lado de quem defende são ignorados (Ferramentas, habilidades e reduções no Ativo dele).
+ * Continuam valendo: os bônus do lado de quem ataca (Treinadores jogados, Ferramentas e habilidades dos próprios
+ * Pokémon, estádio) e a Fraqueza e a Resistência, que não são efeitos.
+ * Antes, cada carta somava o dano direto no Ativo e perdia também os bônus do atacante (ex.: Black Belt's Training,
+ * Binding Mochi) e, no caso do Shred, a Resistência.
+ */
+export function SHRED_DAMAGE(store: StoreLike, state: State, effect: AttackEffect, base: number): State {
+  const player = effect.player;
+  const opponent = StateUtils.getOpponent(state, player);
+  const deal = new DealDamageEffect(effect, base);
+  deal.target = opponent.active;
+  const cards: Card[] = [];
+  state.players.forEach(p => p.stadium.cards.forEach(c => cards.push(c)));
+  // todas as zonas de quem ataca, como no fluxo normal do motor (ex.: a Black Belt's Training age do descarte)
+  player.supporter.cards.forEach(c => cards.push(c));
+  [player.active, ...player.bench].forEach(l => { l.cards.forEach(c => cards.push(c)); l.tools.forEach(t => cards.push(t)); });
+  player.prizes.forEach(pr => pr.cards.forEach(c => cards.push(c)));
+  player.hand.cards.forEach(c => cards.push(c));
+  player.deck.cards.forEach(c => cards.push(c));
+  player.discard.cards.forEach(c => cards.push(c));
+  for (const c of cards) {
+    state = c.reduceEffect(store, state, deal);
+  }
+  if (effect.source.outgoingAttackDamageBonusNextTurn > 0) {
+    deal.damage += effect.source.outgoingAttackDamageBonusNextTurn;
+  }
+  const applyWeakness = new ApplyWeaknessEffect(effect, Math.max(0, deal.damage));
+  applyWeakness.target = opponent.active;
+  state = store.reduceEffect(state, applyWeakness);
+  const damage = applyWeakness.damage;
+  effect.damage = 0;
+  if (damage > 0) {
+    opponent.active.damage += damage;
+    const afterDamage = new AfterDamageEffect(effect, damage);
+    state = store.reduceEffect(state, afterDamage);
+  }
+  return state;
+}
